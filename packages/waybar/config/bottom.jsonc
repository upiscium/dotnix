{
  "layer": "top",
  "position": "bottom",
  "height": 36,
  "modules-left": [
    "hyprland/workspaces"
  ],
  "modules-center": [
    "wlr/taskbar"
  ],
  "modules-right": [
    "tray"
  ],

  "hyprland/workspaces": {
    "format": "{name}",
    "disable-scroll": true,
    "sort-by-number": true,
    "on-click": "activate"
  },

  "wlr/taskbar": {
    "format": "{icon}",
    "icon-size": 25,
    "tooltip": true,
    "tooltip-format": "{title}",
    "on-click": "activate",
    "active-first": true
  },

  "tray": {
    "icon-size": 25,
    "spacing": 8
  }
}
