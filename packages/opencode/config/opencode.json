  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama",
      "options": {
        "baseURL": "https://ollama.arc.upiscium.dev/v1"
      },
      "models": {
        "gemma4:26b": {
          "name": "gemma4:26b",
          "maxTokens": 16384
        },
        "gemma4:12b": {
          "name": "gemma4:12b",
          "maxTokens": 16384
        },
        "qwen3.6:27b": {
          "name": "qwen3.6:27b",
          "maxTokens": 16384
        }
      }
    },
    "ollama-agent": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama Agent Pool",
      "options": {
        "baseURL": "https://ollama-agent.arc.upiscium.dev/v1"
      },
      "models": {
        "gemma4:12b-it-q4_K_M": {
          "name": "gemma4:12b-it-q4_K_M",
          "limit": {
            "context": 65536,
            "output": 16384
          }
        }
      }
    }
