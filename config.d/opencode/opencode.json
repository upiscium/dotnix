{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "build",
  "subagent_depth": 1,
  "permission": {
    "read": {
      "*": "allow",
      "*.env": "ask",
      "*.env.*": "ask",
      "*.env.example": "allow"
    },
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "lsp": "allow",
    "edit": "deny",
    "task": "deny",
    "external_directory": "deny",
    "webfetch": "ask",
    "websearch": "ask",
    "bash": {
      "*": "ask",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "npm test*": "allow",
      "npm run test*": "allow",
      "pnpm test*": "allow",
      "pnpm run test*": "allow",
      "yarn test*": "allow",
      "yarn run test*": "allow",
      "bun test*": "allow",
      "deno test*": "allow",
      "pytest*": "allow",
      "python -m pytest*": "allow",
      "python3 -m pytest*": "allow",
      "cargo test*": "allow",
      "go test*": "allow",
      "dotnet test*": "allow",
      "mix test*": "allow",
      "mvn test*": "allow",
      "./mvnw test*": "allow",
      "gradle test*": "allow",
      "./gradlew test*": "allow",
      "ctest*": "allow",
      "meson test*": "allow",
      "make test*": "allow",
      "just test*": "allow",
      "nix flake check*": "allow",
      "zig test*": "allow",
      "swift test*": "allow",
      "rspec*": "allow",
      "bundle exec rspec*": "allow",
      "phpunit*": "allow",
      "composer test*": "allow",
      "git branch --show-current": "allow",
      "git branch --list": "allow",
      "git remote": "allow",
      "git remote -v": "allow",
      "git rev-parse --show-toplevel": "allow",
      "git ls-files": "allow",
      "git commit*": "ask",
      "git push*": "ask",
      "git merge*": "ask",
      "git reset --hard*": "deny",
      "git clean -fd*": "deny",
      "git push --force*": "deny",
      "git push -f*": "deny",
      "git push*--force*": "deny",
      "git push* -f*": "deny",
      "git push * main*": "deny",
      "git push * master*": "deny",
      "git push*:main*": "deny",
      "git push*:master*": "deny",
      "git commit --amend*": "deny",
      "git rebase*": "deny",
      "git filter-branch*": "deny",
      "git reflog expire*": "deny",
      "rm -rf*": "deny",
      "sudo*": "deny",
      "nix store delete*": "deny"
    }
  },
  "agent": {
    "build": {
      "description": "Primary implementation and integration agent",
      "mode": "primary",
      "model": "openai/gpt-5.6-sol",
      "permission": {
        "edit": "allow",
        "task": "allow",
        "external_directory": "deny"
      },
      "prompt": "You are the primary implementation agent. Establish repository conventions before changing code, decompose substantial work, delegate independent and non-overlapping workstreams to subagents in parallel, inspect every returned diff, integrate changes, request independent verification, and report evidence. Keep final design and integration decisions with yourself. Never let workers edit the same file concurrently. Do not commit, push, merge, create or modify remote issues, or create pull requests unless the user explicitly requests that operation. A merge additionally requires an explicit merge instruction. Never write outside the active worktree."
    },
    "plan": {
      "description": "Read-only requirements, architecture, dependency, and implementation planning agent",
      "mode": "primary",
      "model": "openai/gpt-5.6-sol",
      "permission": {
        "edit": "deny",
        "task": {
          "*": "allow",
          "general": "deny"
        },
        "external_directory": "deny",
        "webfetch": "deny",
        "websearch": "deny",
        "bash": {
          "git status*": "allow",
          "git diff*": "allow",
          "git log*": "allow",
          "git branch --show-current": "allow",
          "git branch --list": "allow",
          "git remote": "allow",
          "git remote -v": "allow",
          "git rev-parse --show-toplevel": "allow",
          "git ls-files": "allow"
        }
      },
      "prompt": "You are a read-only planning agent. Clarify requirements, inspect repository conventions and dependencies, identify risks and invariants, design the implementation, and split work into bounded tasks with explicit dependencies and non-overlapping file scopes. Use subagents only for read-only research. Do not edit files or perform state-changing operations. Separate confirmed facts, assumptions, and unresolved decisions. Finish with an actionable plan, verification strategy, and open questions."
    },
    "general": {
      "description": "Bounded implementation worker for a parent-assigned scope",
      "mode": "subagent",
      "model": "openai/gpt-5.6-luna",
      "permission": {
        "edit": "allow",
        "task": "deny",
        "external_directory": "deny",
        "webfetch": "deny",
        "websearch": "deny",
        "bash": {
          "git status*": "allow",
          "git diff*": "allow",
          "git log*": "allow",
          "git rev-parse --show-toplevel": "allow",
          "git ls-files": "allow",
          "git commit*": "deny",
          "git push*": "deny",
          "git checkout*": "deny",
          "git switch*": "deny",
          "git branch*": "deny",
          "git reset*": "deny",
          "git clean*": "deny",
          "git rebase*": "deny",
          "git filter-branch*": "deny",
          "git reflog expire*": "deny",
          "git merge*": "deny",
          "rm -rf*": "deny",
          "sudo*": "deny",
          "nix store delete*": "deny"
        }
      },
      "prompt": "Implement only the narrow scope assigned by the parent agent. Do not change files outside the assigned scope, introduce independent architecture decisions, or overwrite concurrent work. Follow discovered repository conventions and run the smallest relevant verification after editing. Return: Changed files, Implementation, Verification performed, Unresolved items, and Parent checks."
    },
    "explore": {
      "description": "Fast read-only code search, reference tracing, and file discovery agent",
      "mode": "subagent",
      "model": "openai/gpt-5.6-luna",
      "permission": {
        "edit": "deny",
        "task": "deny",
        "external_directory": "deny",
        "webfetch": "deny",
        "websearch": "deny",
        "bash": {
          "git status*": "allow",
          "git diff*": "allow",
          "git log*": "allow",
          "git rev-parse --show-toplevel": "allow",
          "git ls-files": "allow"
        }
      },
      "prompt": "Perform fast, read-only repository exploration. Locate files, trace definitions and references, and return concise findings with paths and line numbers. Do not edit, design a solution, or run state-changing commands. State searched areas and any uncertainty."
    }
  },
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama",
      "options": {
        "baseURL": "https://ollama.arc.upiscium.dev/v1"
      },
      "models": {
        "gemma4:26b": {
          "name": "gemma4:26b",
          "maxTokens": 16384
        },
        "gemma4:12b": {
          "name": "gemma4:12b",
          "maxTokens": 16384
        },
        "qwen3.6:27b": {
          "name": "qwen3.6:27b",
          "maxTokens": 16384
        }
      }
    }
  }
}
